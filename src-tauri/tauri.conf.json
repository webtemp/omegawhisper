{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Omegawhisper",
  "mainBinaryName": "omegawhisper",
  "version": "0.5.1",
  "identifier": "dev.omegawhisper",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "wtype",
          "libgtk-layer-shell0"
        ]
      },
      "rpm": {
        "depends": [
          "wtype",
          "gtk-layer-shell"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIyNDhGNENGMkVCMjNFMUEKUldRYVBySXV6L1JJc2txLzROUnJzbjBZTG1hbHVudU1Xcm5US1ZPaDlyY3dYcHZ5UlpZM0l0YjQK",
      "endpoints": [
        "https://github.com/webtemp/omegawhisper/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
